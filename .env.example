# =============================================================================
# .env.example — copy to `.env` and fill in. NEVER commit the real `.env`.
#
# This lists EVERY environment variable read anywhere in the codebase.
# Required-for-a-flow variables are validated at startup by config/env.ts and
# fail fast with a clear message if missing. In CI these come from GitHub
# secrets instead of a .env file.
# =============================================================================

# ---- Test environment / reporting ------------------------------------------
# Base-URL selector and report environment label (STAGE | PROD).
ENV=STAGE
# Location under test: USA | CAN | ALL. Leave unset (or ALL) to run one pass per
# location and produce a single Allure report covering both. An unknown value
# fails fast. Can also be passed per-command: LOCATION=CAN npm test
LOCATION=
# Browser the web pass runs under: chrome | firefox | webkit.
BROWSER=chrome
# Public URL of the published Allure report, linked in the email report.
ALLURE_REPORT_URL=

# ---- Email report (scripts/send-allure-email-report.ts) ---------------------
# Required to actually send the report; if unset the send is skipped (not fatal).
# For Gmail SMTP, EMAIL_USER should be the full Gmail address and EMAIL_PASSWORD
# should be a Google App Password, not the normal account password.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
EMAIL_CC=

# ---- Jira integration (jira:fetch / jira:analyze / generate:*) --------------
# Required by utils/jiraClient.ts. Create an API token at
# https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=

# ---- Lead-form API capture (pages/BasePage.ts, utils/leadApiCapture.ts) -----
# When true, tests assert a lead-form API call was captured.
REQUIRE_LEAD_API_CAPTURE=false
# URL substring/pattern that identifies the lead-form API request.
LEAD_API_URL_PATTERN=
# Output path for captured lead API data (xlsx). Defaults under results/.
LEAD_API_CAPTURE_XLSX=

# ---- Mobile web (device profiles of the Playwright suite) -------------------
# Which platforms a run covers: web | mobile | web,mobile. Read by
# scripts/run-locations.ts, which gives each platform its own Playwright process
# and its own Allure results dir. This is the only place a run's platform
# coverage is set - no npm script pins it - so a local run matches CI, which
# pins web,mobile in the workflow. Both platforms roughly doubles wall clock, so
# narrow it per command when you only need one: PLATFORMS=web npm run test:regression
PLATFORMS=web,mobile
# Device profile the mobile pass runs under: mobile-safari (iPhone 14 / WebKit)
# or mobile-chrome (Pixel 7). Defaults to mobile-safari, since WebKit is the
# engine every iOS browser uses.
MOBILE_BROWSER=mobile-safari

# ---- CI ---------------------------------------------------------------------
# CI=true is set automatically by GitHub Actions; do not set locally.
# CI=true
