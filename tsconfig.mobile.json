{
  // Mobile (WebdriverIO + Appium + Mocha) type-check profile.
  //
  // The mobile suite runs through ts-node in transpile-only mode (see
  // wdio.mobile.conf), so types are never checked at runtime - this config is
  // what `npm run typecheck:mobile` and the editor use. It relaxes `strict`
  // relative to the base tsconfig because the page objects are dominated by
  // `driver.execute()` DOM callbacks and dynamic selector logic; strictness can
  // be tightened incrementally once the layer has settled in TypeScript.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "strict": false,
    "noImplicitAny": false,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "types": ["node", "@wdio/globals/types", "mocha", "expect-webdriverio"]
  },
  "include": [
    "types/**/*.d.ts",
    "pages/mobile/**/*.ts",
    "tests/mobile/**/*.ts",
    "utils/**/*.ts",
    "config/**/*.ts",
    "data/**/*.json",
    "scripts/allurePaths.ts",
    "wdio.mobile.conf.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
