{
  "name": "mattamyhomes_automation",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "homepage": "https://github.com/SudhansuSD/mattamyhomes_automation#readme",
  "bugs": {
    "url": "https://github.com/SudhansuSD/mattamyhomes_automation/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SudhansuSD/mattamyhomes_automation.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "npx playwright test",
    "clean:allure:desktop": "rimraf allure-results/desktop allure-report/desktop",
    "clean:allure:mobile": "rimraf allure-results/mobile allure-report/mobile",
    "clean:allure:merged": "rimraf allure-report/merged",
    "clean:allure": "npm run clean:allure:desktop && npm run clean:allure:mobile && npm run clean:allure:merged",
    "allure:generate": "ts-node scripts/generate-allure-report.ts desktop",
    "allure:generate:desktop": "ts-node scripts/generate-allure-report.ts desktop",
    "allure:generate:mobile": "ts-node scripts/generate-allure-report.ts mobile",
    "allure:merge": "ts-node scripts/generate-allure-report.ts merged",
    "allure:open": "npx allure open allure-report/desktop",
    "allure:open:desktop": "npx allure open allure-report/desktop",
    "allure:open:mobile": "npx allure open allure-report/mobile",
    "allure:open:merged": "npx allure open allure-report/merged",
    "allure:serve": "npx allure serve allure-results/desktop",
    "allure:serve:desktop": "npx allure serve allure-results/desktop",
    "allure:serve:mobile": "npx allure serve allure-results/mobile",
    "allure:serve:merged": "npx allure serve allure-results/desktop allure-results/mobile",
    "test:allure": "npm run clean:allure:desktop && npx playwright test && npm run allure:generate:desktop",
    "report:email": "ts-node scripts/send-allure-email-report.ts",
    "test:allure:email": "ts-node scripts/run-allure-email-workflow.ts",
    "test:ci": "npm run clean:allure && npx playwright test --project=Chrome --grep @ci",
    "test:smoke": "npm run clean:allure && npx playwright test --project=Chrome --grep @smoke",
    "test:regression": "npm run clean:allure && npx playwright test --project=Chrome --grep @regression",
    "jira:fetch": "ts-node scripts/fetch-jira-requirement.ts",
    "jira:analyze": "ts-node scripts/analyze-jira-requirement.ts",
    "generate:spec": "ts-node scripts/generate-playwright.ts",
    "generate:from-jira": "ts-node scripts/generate-from-jira.ts",
    "generate:testcases": "ts-node scripts/generate-testcases.ts",
    "generate:automation": "ts-node scripts/generate-automation.ts",
    "docs:generate": "ts-node scripts/generate-docs.ts",
    "docs:inject-ids": "ts-node scripts/generate-docs.ts --inject-ids",
    "test:mobile:allure": "npm run clean:allure:mobile && wdio run wdio.mobile.conf.js && npm run allure:generate:mobile && npm run allure:open:mobile",
    "test:mobile:android": "wdio run wdio.mobile.conf.js",
    "test:mobile:android:home": "wdio run wdio.mobile.conf.js --spec ./tests/mobile/mobileWeb.home.spec.js",
    "test:mobile:android:search": "wdio run wdio.mobile.conf.js --spec ./tests/mobile/mobileWeb.searchPage.spec.js",
    "test:mobile:android:community": "wdio run wdio.mobile.conf.js --spec ./tests/mobile/mobileWeb.community.spec.js",
    "test:mobile:android:market": "wdio run wdio.mobile.conf.js --spec ./tests/mobile/mobileWeb.market.spec.js",
    "test:mobile:android:mpc": "wdio run wdio.mobile.conf.js --spec ./tests/mobile/mobileWeb.mpc.spec.js",
    "test:mobile:android:plan": "wdio run wdio.mobile.conf.js --spec ./tests/mobile/mobileWeb.plan.spec.js",
    "test:mobile:android:qmi": "wdio run wdio.mobile.conf.js --spec ./tests/mobile/mobileWeb.qmi.spec.js",
    "test:mobile:android:forms": "wdio run wdio.mobile.conf.js --spec ./tests/mobile/mobileWeb.plan.spec.js --spec ./tests/mobile/mobileWeb.qmi.spec.js",
    "test:mobile:ios": "MOBILE_PLATFORM=ios wdio run wdio.mobile.conf.js",
    "test:mobile:ios:home": "MOBILE_PLATFORM=ios wdio run wdio.mobile.conf.js --spec ./tests/mobile/mobileWeb.home.spec.js",
    "test:mobile:ios:search": "MOBILE_PLATFORM=ios wdio run wdio.mobile.conf.js --spec ./tests/mobile/mobileWeb.searchPage.spec.js",
    "test:mobile:ios:community": "MOBILE_PLATFORM=ios wdio run wdio.mobile.conf.js --spec ./tests/mobile/mobileWeb.community.spec.js",
    "test:mobile:ios:market": "MOBILE_PLATFORM=ios wdio run wdio.mobile.conf.js --spec ./tests/mobile/mobileWeb.market.spec.js",
    "test:mobile:ios:mpc": "MOBILE_PLATFORM=ios wdio run wdio.mobile.conf.js --spec ./tests/mobile/mobileWeb.mpc.spec.js",
    "test:mobile:ios:plan": "MOBILE_PLATFORM=ios wdio run wdio.mobile.conf.js --spec ./tests/mobile/mobileWeb.plan.spec.js",
    "test:mobile:ios:qmi": "MOBILE_PLATFORM=ios wdio run wdio.mobile.conf.js --spec ./tests/mobile/mobileWeb.qmi.spec.js",
    "appium:driver:install": "appium driver install uiautomator2",
    "appium:driver:install:ios": "appium driver install xcuitest",
    "appium:doctor:android": "appium driver doctor uiautomator2",
    "appium:doctor:ios": "appium driver doctor xcuitest"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "playwright-core": "^1.57.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.0",
    "@wdio/allure-reporter": "^9.27.2",
    "@wdio/appium-service": "^9.27.0",
    "@wdio/cli": "^9.27.0",
    "@wdio/local-runner": "^9.27.0",
    "@wdio/mocha-framework": "^9.27.1",
    "allure-commandline": "^2.42.0",
    "allure-playwright": "^3.9.0",
    "appium": "^3.3.1",
    "appium-uiautomator2-driver": "^7.1.2",
    "axios": "^1.14.0",
    "chartjs-node-canvas": "^5.0.0",
    "dotenv": "^17.4.2",
    "nodemailer": "^8.0.10",
    "playwright": "^1.57.0",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "webdriverio": "^9.27.0"
  }
}
