{
  "name": "mattamyhomes_automation",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "homepage": "https://github.com/SudhansuSD/mattamyhomes_automation#readme",
  "bugs": {
    "url": "https://github.com/SudhansuSD/mattamyhomes_automation/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SudhansuSD/mattamyhomes_automation.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "playwright test",
    "test:ci": "playwright test --project=Chrome --grep @ci",
    "test:smoke": "playwright test --project=Chrome --grep @smoke",
    "test:regression": "playwright test --project=Chrome --grep @regression",
    "jira:scenario": "ts-node scripts/fetch-jira-scenarios.ts",
    "mcp:fetch-jira": "ts-node scripts/fetch-mcp-requirement.ts",
    "mcp:ingest": "ts-node scripts/ingest-mcp-requirement.ts",
    "generate:testcases": "ts-node scripts/generate-testcases.ts",
    "generate:automation": "ts-node scripts/generate-automation.ts",
    "generate:spec": "ts-node scripts/generate-playwright.ts",
    "generate:from-mcp": "npm run mcp:ingest && npm run generate:testcases && npm run generate:automation && npm run generate:spec",
    "generate:from-jira-input": "npm run generate:testcases && npm run generate:automation && npm run generate:spec",
    "test:mobile:appium": "wdio run wdio.mobile.conf.js",
    "test:mobile:android": "wdio run wdio.mobile.conf.js",
    "test:mobile:android:home": "wdio run wdio.mobile.conf.js --spec ./tests/appium/mobileWeb.home.spec.js",
    "test:mobile:android:fyh": "wdio run wdio.mobile.conf.js --spec ./tests/appium/mobileWeb.findYourHome.spec.js",
    "test:mobile:android:community": "wdio run wdio.mobile.conf.js --spec ./tests/appium/mobileWeb.community.spec.js",
    "test:mobile:android:forms": "wdio run wdio.mobile.conf.js --spec ./tests/appium/mobileWeb.form.spec.js",
    "appium:driver:install": "appium driver install uiautomator2",
    "appium:doctor:android": "appium driver doctor uiautomator2",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results"
  },
  "dependencies": {
    "playwright-core": "^1.57.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "@wdio/appium-service": "^9.27.0",
    "@wdio/cli": "^9.27.0",
    "@wdio/local-runner": "^9.27.0",
    "@wdio/mocha-framework": "^9.27.1",
    "@wdio/spec-reporter": "^9.27.0",
    "allure-commandline": "^2.38.1",
    "allure-playwright": "^3.7.1",
    "appium": "^3.3.1",
    "appium-uiautomator2-driver": "^7.1.2",
    "axios": "^1.14.0",
    "dotenv": "^17.4.2",
    "playwright": "^1.57.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "webdriverio": "^9.27.0"
  }
}
