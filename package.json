{
  "name": "mattamyhomes_automation",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "homepage": "https://github.com/SudhansuSD/mattamyhomes_automation#readme",
  "bugs": {
    "url": "https://github.com/SudhansuSD/mattamyhomes_automation/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SudhansuSD/mattamyhomes_automation.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "engines": {
    "node": ">=20"
  },
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "ts-node scripts/run-locations.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "clean:allure:desktop": "rimraf allure-results/desktop allure-report/desktop",
    "clean:allure:mobile": "rimraf allure-results/mobile allure-report/mobile",
    "clean:allure:merged": "rimraf allure-report/merged",
    "clean:allure": "npm run clean:allure:desktop && npm run clean:allure:mobile && npm run clean:allure:merged",
    "allure:generate": "ts-node scripts/generate-allure-report.ts desktop",
    "allure:generate:mobile": "ts-node scripts/generate-allure-report.ts mobile",
    "allure:merge": "ts-node scripts/generate-allure-report.ts merged",
    "allure:open": "npx allure open allure-report/desktop",
    "allure:open:mobile": "npx allure open allure-report/mobile",
    "allure:open:merged": "npx allure open allure-report/merged",
    "allure:watch": "npx allure watch allure-results/desktop",
    "allure:watch:mobile": "npx allure watch allure-results/mobile",
    "test:allure": "npm run clean:allure:desktop && ts-node scripts/run-locations.ts",
    "report:email": "ts-node scripts/send-allure-email-report.ts",
    "report:publish": "ts-node scripts/publish-report-site.ts publish",
    "report:history:restore": "ts-node scripts/publish-report-site.ts restore",
    "test:allure:email": "ts-node scripts/run-allure-email-workflow.ts",
    "test:ci": "npm run clean:allure && ts-node scripts/run-locations.ts --grep @ci --grep-invert \"@visual|@a11y\"",
    "test:smoke": "npm run clean:allure && ts-node scripts/run-locations.ts --grep @smoke --grep-invert \"@visual|@a11y\"",
    "test:regression": "npm run clean:allure && ts-node scripts/run-locations.ts --grep @regression --grep-invert \"@visual|@a11y\"",
    "test:a11y": "ts-node scripts/run-locations.ts --grep @a11y",
    "test:visual": "ts-node scripts/run-locations.ts --grep @visual",
    "test:visual:update": "npx playwright test tests/visualRegression.spec.ts --update-snapshots",
    "test:lead-submit": "ts-node scripts/run-locations.ts --grep @lead-submit",
    "jira:fetch": "ts-node scripts/fetch-jira-requirement.ts",
    "jira:analyze": "ts-node scripts/analyze-jira-requirement.ts",
    "generate:spec": "ts-node scripts/generate-playwright.ts",
    "generate:from-jira": "ts-node scripts/generate-from-jira.ts",
    "generate:testcases": "ts-node scripts/generate-testcases.ts",
    "generate:automation": "ts-node scripts/generate-automation.ts",
    "docs:generate": "ts-node scripts/generate-docs.ts",
    "docs:inject-ids": "ts-node scripts/generate-docs.ts --inject-ids"
  },
  "lint-staged": {
    "*.{ts,mts,cts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml}": [
      "prettier --write --ignore-unknown"
    ]
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "playwright-core": "^1.57.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.0",
    "allure": "^3.14.3",
    "allure-js-commons": "^3.9.0",
    "allure-playwright": "^3.9.0",
    "axios": "^1.14.0",
    "chartjs-node-canvas": "^5.0.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "nodemailer": "^8.0.10",
    "playwright": "^1.57.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
