{
  "tests": [
    {
      "id": "TC001",
      "name": "Validate source URL redirects correctly",
      "actions": [
        {
          "type": "navigate",
          "url": "/sunstone"
        },
        {
          "type": "waitForNavigation"
        },
        {
          "type": "assertUrlContains",
          "value": "/florida/sarasota/bradenton/venice/wellen-park/sunstone"
        }
      ]
    },
    {
      "id": "TC002",
      "name": "Validate redirected destination URL is correct",
      "actions": [
        {
          "type": "navigate",
          "url": "/sunstone"
        },
        {
          "type": "waitForNavigation"
        },
        {
          "type": "assertUrlContains",
          "value": "/florida/sarasota/bradenton/venice/wellen-park/sunstone"
        }
      ]
    }
  ]
}