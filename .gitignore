# =============================================================================
# .gitignore — ignore ONLY generated / local artifacts.
#
# Everything the tests, config, and CI actually need is committed:
#   - source (pages/, tests/, utils/, scripts/, config/, reporters/, types/)
#   - playwright.config.ts, wdio.mobile.conf.ts
#   - tsconfig*.json, package.json, package-lock.json
#   - data/*.json fixtures the tests import (e.g. data/test_data.json)
#
# Do NOT re-introduce blanket rules like `*.json`, `*.csv`, `*.xlsx`, or
# `/playwright.config.ts` — they silently drop committed, required files.
# =============================================================================

# ---- Dependencies -----------------------------------------------------------
node_modules/

# ---- Python virtualenv (no Python sources in this repo — leftover/local) ----
.venv/
__pycache__/
*.pyc

# ---- TypeScript build output (generated by tsc) -----------------------------
dist/
*.tsbuildinfo

# ---- Playwright -------------------------------------------------------------
test-results/
playwright-report/
blob-report/
playwright/.cache/
playwright/.auth/

# ---- Allure (results + generated report, desktop/mobile/merged) -------------
allure-results/
allure-report/
*/allure-results/
*/allure-report/

# ---- Logs -------------------------------------------------------------------
*.log
log/

# ---- Generated reports / evidence / artifacts -------------------------------
reports/
results/
artifacts/
sitemap_report.html

# ---- Generated data ---------------------------------------------------------
# NOTE: data/*.json fixtures ARE committed. Only the machine-generated inputs
# and per-ticket working files below are ignored.
data/generated-testcases.json
data/requirement-input.json
data/mcp-requirement.json
data/jira/
test_cases_checklist.csv

# ---- Local secrets / environment -------------------------------------------
# .env.example is committed (see the rule below); real secrets are never.
.env
.env.local
.env.*.local

# ---- Local-only / intentionally untracked spec files ------------------------
# These evidence/one-off specs are deliberately kept out of version control.
# Do not delete the files on disk — only their tracking is suppressed here.
*MTTMY-*
manual-tests.md
tests/sitemapXml.spec.ts
tests/formSubmissionEvidence.spec.ts
tests/formProfaneSubmissionEvidence.spec.ts
tests/pasadenaRidge404.spec.ts
tests/scheduleAVisitCanadaFormEvidence.spec.ts
tests/sideModalFormEvidence.spec.ts

# ---- Keep .env.example tracked even though .env* is ignored above -----------
!.env.example
